+    rx_state_t state;
+    reg [COUNT_WIDTH-1:0] count;
+    reg [2:0] bit_index;
+    reg [7:0] shift_data;
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            state <= IDLE;
+            count <= 0;
+            bit_index <= 0;
+            shift_data <= 0;
+            rx_dout <= 0;
+            rx_vld <= 0;
+        end else begin
+            rx_vld <= 0;
+            case (state)
+                IDLE: begin
+                    count <= 0;
+                    if (!din_sync[1]) state <= START;
